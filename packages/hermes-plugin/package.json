{
  "name": "@openuidev/hermes-os-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Hermes Agent plugin assets for Hermes OS OpenUI guidance.",
  "keywords": [
    "hermes",
    "hermes-agent",
    "hermes-plugin",
    "openui",
    "openui-lang",
    "generative-ui"
  ],
  "license": "MIT",
  "homepage": "https://openui.com/hermes-os",
  "repository": {
    "type": "git",
    "url": "https://github.com/Minoo7/hermes-os.git",
    "directory": "packages/hermes-plugin"
  },
  "files": [
    "plugin.yaml",
    "__init__.py",
    "prompts",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/validate-plugin.mjs",
    "open": "node ../../scripts/open-ui.mjs",
    "lint:check": "node scripts/validate-plugin.mjs",
    "lint:fix": "node scripts/validate-plugin.mjs",
    "format:check": "prettier --check README.md plugin.yaml prompts skills scripts",
    "format:fix": "prettier --write README.md plugin.yaml prompts skills scripts",
    "typecheck": "node scripts/validate-plugin.mjs",
    "test": "node scripts/validate-plugin.mjs",
    "ci": "pnpm lint:check && pnpm format:check && pnpm typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "prettier": "^3.2.5"
  }
}
